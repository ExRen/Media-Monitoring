# ============================================
# MedMon - Environment Variables
# ============================================
# Copy file ini menjadi .env dan isi sesuai kebutuhan:
#   cp .env.example .env

# NewsData.io API Key (daftar di https://newsdata.io/register)
NEWSDATA_API_KEY=your_api_key_here

# Berita Indo API URL (deploy ke Vercel terlebih dahulu)
BERITA_API_URL=https://your-berita-api.vercel.app

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medmon

# Password admin default (ganti setelah login pertama)
DEFAULT_ADMIN_PASSWORD=changeme

# Path ke folder model sentiment IndoBERT (relatif atau absolut)
SENTIMENT_MODEL_PATH=asabri_sentiment_model
